# Local: no pongas VITE_CARA. Conviven /estudio y /jugar.
# En producción: 'estudio' para SHIRO-GAMES y 'jugar' para el cliente.
VITE_CARA=
VITE_DOMINIO_JUGAR=https://juegos.shiro-games.example.com
